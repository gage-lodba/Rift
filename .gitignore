# Generated by Cargo
# will have compiled files and executables
debug
target
# Scratch target dirs (`CARGO_TARGET_DIR=target-verify cargo test`, for building
# without disturbing a running binary that holds target/debug/*.exe open)
target-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Release staging (the release workflow copies the built binary here before
# uploading it to a GitHub release)
/release-assets/
# Local verification outputs: screenshots, rendered frames, probe artifacts
/artifacts/
/.probe/

# Runtime logs (a redirected launch keeps these open for as long as the app runs,
# so they can't be deleted while testing)
*.log

# Python tooling caches
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# rustypipe cache/reports
rustypipe_reports/
/CLAUDE.md

# Local Vulkano probe / scratch space
/scratch/
