# Generated by Cargo
# will have compiled files and executables
debug
target
# Scratch target dirs (`CARGO_TARGET_DIR=target-verify cargo test`, for building
# without disturbing a running binary that holds target/debug/*.exe open)
target-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Trunk build output
/dist

# Runtime logs (a redirected launch keeps these open for as long as the app runs,
# so they can't be deleted while testing)
*.log

# rustypipe cache/reports
rustypipe_reports/
/CLAUDE.md

# Tauri build output: the ACL/capability schemas and the per-command permission
# files are regenerated by build.rs on every build, churn on every dependency
# bump, and can drift from the real plugin set. Upstream's template ignores
# /gen/schemas for the same reason. `permissions/default.toml` is hand-written
# and *is* tracked.
/src-tauri/gen
/src-tauri/permissions/autogenerated
